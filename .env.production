# Read by src/lib/api.ts at build time. Pages and the Worker are different
# origins, so the production build needs the Worker's real URL rather than
# the relative /api path dev gets via Vite's proxy (vite.config.ts).
#
# Placeholder — swap it for the *.workers.dev URL `npm run deploy:api` prints
# (or your custom domain) before running `npm run deploy:web`. See the
# README's "Deploy to your own Cloudflare account" section.
#
# Don't edit this file with your real URL: put it in `.env.production.local`
# instead (gitignored via *.local) — Vite prefers `.local` automatically, so
# your real value never risks getting committed.
VITE_API_URL=https://your-worker.your-subdomain.workers.dev
